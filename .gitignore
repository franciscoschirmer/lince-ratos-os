# fora do git: cada máquina tem o seu
.origem
.agents/
.env
.env.*

# conversas exportadas (dados de clientes, nunca no GitHub)
operacao/conversas/

# cache local da Cloudflare (wrangler)
.wrangler/

# exports semanais dos grupos de cliente (dados de clientes, trocados toda semana)
operacao/auditoria-grupos/exports/

# segredos locais do wrangler (teste)
.dev.vars

# log local das filas (Agendador do Windows)
.claude/skills/fila-aprovacao/ultima-execucao.log

# tokens de página do Meta (gerado por operacao/filas-worker/scripts/meta-contas.mjs)
operacao/filas-worker/contas-meta.json
operacao/filas-worker/.tmp/

# vídeo e áudio de edição: pesados, ficam só no computador
*.mp4
*.mov
*.MOV
*.wav
*.m4a
**/conteudos/*/frames/

# referências de vídeo de cliente (pesadas, ficam só no computador)
**/referencias/*.mp4
**/referencias/*.mov
**/referencias/frames/

# vídeo de banco e voz tratada (pesados, ficam só no computador)
**/conteudos/*/banco/*.mp4
**/conteudos/*/*.wav
.claude/skills/edicao-completa/sons/*.wav
