  {
   "ini": 0.0,
   "fim": 3.4,
   "txt": "Doutora, tem alguma medicação que ajude a ter mais disposição?"
  },
  {
   "ini": 3.74,
   "fim": 6.62,
   "txt": "Gente, essa resposta é difícil de dar, né?"
  },
  {
   "ini": 6.72,
   "fim": 14.28,
   "txt": "Porque tem tanta coisa que pode causar cansaço físico, mental, indisposição, tanta coisa."
  },
  {
   "ini": 15.08,
   "fim": 20.54,
   "txt": "Desidratação, falta de proteína na dieta, privação de sono, falta de músculo, falta de exercício,"
  },
  {
   "ini": 20.58,
   "fim": 25.88,
   "txt": "níveis baixos de ferro, de vitaminas, de micronutrientes, tanta coisa."
