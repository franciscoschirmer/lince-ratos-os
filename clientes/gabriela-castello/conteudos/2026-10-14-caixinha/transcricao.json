   "txt": "Tanta coisa pode causar"
  },
  {
   "ini": 31.94,
   "fim": 33.66,
   "txt": "Que aí dependendo do que tiver"
  },
  {
   "ini": 33.66,
   "fim": 34.96,
   "txt": "Baixo"
  },
  {
   "ini": 34.96,
   "fim": 37.14,
   "txt": "Ou que tiver alterado"
  },
  {
   "ini": 37.14,
   "fim": 39.08,
   "txt": "Você precisa melhorar"
  },
  {
   "ini": 39.08,
   "fim": 40.12,
   "txt": "Para melhorar a disposição"
  },
  {
   "ini": 40.12,
   "fim": 43.12,
   "txt": "Mas fato é que eu sou"
  },
  {
   "ini": 43.12,
   "fim": 44.78,
   "txt": "Uma grande fã"
  },
  {
   "ini": 44.78,
