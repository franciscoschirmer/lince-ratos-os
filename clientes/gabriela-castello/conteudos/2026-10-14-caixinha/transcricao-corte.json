  {
   "ini": 0.0,
   "fim": 3.38,
   "txt": "Doutora, tem alguma medicação que ajude a ter mais disposição?"
  },
  {
   "ini": 3.5,
   "fim": 10.16,
   "txt": "E tem tanta coisa que pode causar cansaço físico, mental, indisposição, tanta coisa."
  },
  {
   "ini": 10.96,
   "fim": 16.14,
   "txt": "Desidratação, falta de proteína na dieta, privação de sono, falta de músculo, falta de exercício,"
  },
  {
   "ini": 16.24,
   "fim": 21.3,
   "txt": "níveis baixos de ferro, de vitaminas, de micronutrientes, tanta coisa."
  },
  {
   "ini": 21.34,
   "fim": 25.26,
   "txt": "Hormônio baixo também, dependendo da faixa etária do paciente."
  },
  {
   "ini": 25.26,
   "fim": 32.06,
   "txt": "tanta coisa pode causar que dependendo do que tiver baixo ou que tiver alterado"
  },
  {
   "ini": 32.06,
   "fim": 34.9,
   "txt": "você precisa melhorar para melhorar a disposição"
  },
  {
   "ini": 34.9,
   "fim": 42.52,
   "txt": "mas fato é que eu sou uma grande fã de dois peptídeos que ajudam demais na disposição"
  },
  {
   "ini": 42.52,
   "fim": 44.24,
   "txt": "e eu uso muito aqui no consultório"
  },
  {
   "ini": 44.24,
   "fim": 47.26,
